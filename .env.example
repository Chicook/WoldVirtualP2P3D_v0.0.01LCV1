# Copia este archivo a .env y rellena los valores.
# .env esta en .gitignore: NUNCA subas el archivo real al repositorio.

# Clave de OpenRouter para el subsistema IAFREE (modelos :free)
OPENROUTER_API_KEY=tu_api_key_aqui

# URL del servidor LM Studio local (opcional)
LMSTUDIO_URL=http://127.0.0.1:1234/v1

# URL de Ollama local (opcional; por defecto http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Modo simple del subsistema (1 = activo)
LUCIA_SIMPLE=1
